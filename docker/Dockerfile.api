FROM python:3.12-slim

WORKDIR /app

RUN groupadd -r evolis && useradd -r -g evolis evolis

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chown -R evolis:evolis /app
USER evolis

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3)" || exit 1

# Applies pending Alembic migrations, then starts the API. Safe to run on
# every container start: a no-op when the schema is already current.
CMD ["sh", "-c", "alembic upgrade head && uvicorn apps.api.main:app --host 0.0.0.0 --port 8000"]
