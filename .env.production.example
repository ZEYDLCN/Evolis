# Production environment template for docker-compose.prod.yml. Copy to
# .env.production and fill in every value below — several are required and
# the app refuses to boot without them (see apps/api/main.py's
# _check_production_config). Never commit the filled-in file.

ENVIRONMENT=production

# --- Database (Postgres + pgvector) ---
# docker-compose.prod.yml builds DATABASE_URL from these for you; only
# needed here directly if you're not using that compose file.
POSTGRES_USER=evolis
POSTGRES_PASSWORD=REPLACE_ME_with_a_long_random_password
POSTGRES_DB=evolis

# json (works anywhere) | pgvector (requires the Postgres above)
EMBEDDING_BACKEND=pgvector
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated, no wildcard, no trailing slashes. Must be set in
# production or the API refuses to start.
CORS_ALLOWED_ORIGINS=https://app.your-domain.example

# --- Frontend build ---
# Baked into the client bundle at image-build time (see apps/frontend/Dockerfile).
PUBLIC_API_URL=https://api.your-domain.example

# --- LLM (optional) ---
# Unset both = deterministic heuristic fallbacks instead of real LLM calls.
# If both are set, GROQ_API_KEY wins (see src/llm/provider.py).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# --- Sign in with Google (optional) ---
GOOGLE_CLIENT_ID=

# --- At-rest encryption (optional but recommended for production) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Auth rate limiting ---
# Requests per window per (IP, path) on /auth/login and /auth/register.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Background jobs ---
# docker-compose.prod.yml sets this for you to the compose-internal Redis.
REDIS_URL=redis://redis:6379/0

# --- Knowledge Graph sync (optional) ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
