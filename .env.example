# Database. Defaults to local SQLite if unset.
DATABASE_URL=postgresql+psycopg://evolis:evolis@localhost:5432/evolis

# json (default, works anywhere) | pgvector (requires Postgres + pgvector extension)
EMBEDDING_BACKEND=json

# multilingual model recommended for Turkish + English entries
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Set either of these to enable real LLM-backed extraction / Ask Evolis
# explanations / cluster naming. Without either, the app uses deterministic
# heuristic fallbacks (see src/llm/provider.py). If both are set, GROQ_API_KEY
# wins. Get a free key at https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: Sign in with Google. Create an OAuth 2.0 Client ID ("Web
# application") at https://console.cloud.google.com/apis/credentials, and
# add both http://localhost:3000 and your real frontend origin under
# "Authorized JavaScript origins". Unset = GET /auth/google/config reports
# {enabled: false} and the frontend just doesn't render the button, rather
# than rendering a broken one. The frontend fetches the client ID from that
# endpoint at runtime, so it only needs to be set here, once.
GOOGLE_CLIENT_ID=

# Optional: encrypts Entry.raw_text at rest (AES via cryptography.fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset for plaintext storage (the default — fine for local dev).
ENCRYPTION_KEY=

# Background jobs
REDIS_URL=redis://localhost:6379/0

# Optional: Knowledge Graph sync (section 25). Unset = GET /graph/export
# still works (pure JSON), POST /graph/sync just reports it skipped.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
