# Database. Defaults to local SQLite if unset.
DATABASE_URL=postgresql+psycopg://lifediff:lifediff@localhost:5432/lifediff

# json (default, works anywhere) | pgvector (requires Postgres + pgvector extension)
EMBEDDING_BACKEND=json

# multilingual model recommended for Turkish + English entries
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Set to enable real LLM-backed extraction / Ask LifeDiff explanations.
# Without it, the app uses deterministic heuristic fallbacks.
ANTHROPIC_API_KEY=

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Background jobs
REDIS_URL=redis://localhost:6379/0
